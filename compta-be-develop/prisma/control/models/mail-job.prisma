// Outbox of outgoing emails. RabbitMQ only carries the row id, so links with tokens never reach the broker.
model MailJob {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String?       @map("tenant_id") @db.Uuid
  kind        String
  status      MailJobStatus @default(QUEUED)
  attempts    Int           @default(0)
  // AES-256-GCM of the rendered message; cleared once the job ends
  payloadEnc  String?       @map("payload_enc")
  lastError   String?       @map("last_error")
  publishedAt DateTime?     @map("published_at")
  sentAt      DateTime?     @map("sent_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@map("mail_jobs")
}
