# Backend reached by the /api proxy, from the server side only.
BACKEND_URL=http://127.0.0.1:3000

# Public domains of this app, comma separated. Opening <tenant>.<domain> selects that company and
# platform.<domain> opens the Super Admin portal. On a LAN, nip.io resolves any name to the IP it
# contains, with no DNS setup: put this machine's current IP here and update it when DHCP changes it.
#   FE_BASE_DOMAINS=192.168.30.13.nip.io,localhost
#   -> http://dfm.192.168.30.13.nip.io:3001, http://acme.192.168.30.13.nip.io:3001,
#      http://platform.192.168.30.13.nip.io:3001
# In production: FE_BASE_DOMAINS=dfm-europe.com
FE_BASE_DOMAINS=localhost

# Company used when the address is not under FE_BASE_DOMAINS, such as a bare IP or machine name.
TENANT_SUBDOMAIN=dfm

# The backend's own base domain, as set in its configuration. Not the address users open.
APP_BASE_DOMAIN=localhost

# Extra hostnames allowed to reach the dev server, comma separated.
# This machine's own IPv4 addresses are always allowed.
ALLOWED_DEV_ORIGINS=
