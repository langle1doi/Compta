NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Human-readable logs (dev only)
LOG_PRETTY=true
# Number of reverse-proxy hops in front of the API (for client IPs / rate limiting)
TRUST_PROXY=0

# Base domain: tenant "dfm" is served at dfm.<APP_BASE_DOMAIN>
APP_BASE_DOMAIN=localhost
# Extra CORS origins, comma separated (*.APP_BASE_DOMAIN is always allowed)
CORS_ORIGINS=
# Tenant frontend, used in links sent by email. Required in production.
APP_PUBLIC_URL_TEMPLATE=http://{subdomain}.localhost:3001

# Control plane DB (tenants, plans, platform admins)
CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compte_control

# Superuser connection used ONLY to create/drop tenant databases and roles
TENANT_DB_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Address of the "default" tenant DB cluster as seen from THIS process (read at runtime, never stored per tenant):
# localhost here, "postgres" inside docker compose
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
# Tenant databases/roles are named <prefix><subdomain>
TENANT_DB_NAME_PREFIX=tenant_

# Used by `prisma migrate dev` for the tenant schema (a dev/template tenant DB)
TENANT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compte_tenant_dev

# 32-byte key, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
DB_CREDENTIALS_KEY=change-me-base64-32-bytes

# Two different random strings: tenant tokens and Super Admin tokens never share a key
JWT_SECRET=change-me-to-a-long-random-string
PLATFORM_JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m

# Sessions (F02 AC-07, BR-02): the session limits apply whatever the refresh token lifetime
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
REFRESH_TOKEN_DAYS=7

# Mandatory 2FA for Admin tenant, Owner, Accountant (F02 BR-03). Off for local development; production defaults to true.
MFA_ENFORCED=false
# Seconds a spent refresh token still works from the same client (two tabs refreshing together); 0 turns it off
REFRESH_REUSE_GRACE_SECONDS=10

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Requests per minute: per IP (all routes), per IP and per email (login routes), per IP (2FA codes)
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_LOGIN_LIMIT=10
THROTTLE_LOGIN_EMAIL_LIMIT=10
THROTTLE_MFA_LIMIT=5

# RabbitMQ. docker compose creates this account; production refuses to start with a default password.
RABBITMQ_DEFAULT_USER=compte
RABBITMQ_DEFAULT_PASS=compte-dev-rabbitmq
RABBITMQ_URL=amqp://compte:compte-dev-rabbitmq@localhost:5672
RABBITMQ_QUEUE_PREFIX=compte
# Delay before each retry (ms); after the last one a job goes to the dead-letter queue
QUEUE_RETRY_DELAYS_MS=2000,10000,60000
# false: this process only publishes (a separate worker pod consumes)
WORKER_ENABLED=true

# Object storage (S3 API, MinIO). docker compose creates this account; production refuses default keys.
MINIO_ROOT_USER=compte
MINIO_ROOT_PASSWORD=compte-dev-minio
S3_ENDPOINT=http://localhost:9000
# What the browser reaches, written in presigned URLs. Defaults to S3_ENDPOINT.
# With docker compose it defaults to http://localhost:<MINIO_PORT>; set it only for another address, since it wins over MINIO_PORT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=compte
S3_SECRET_KEY=compte-dev-minio
S3_BUCKET=compte

# Email. Empty MAIL_HOST = nothing is sent. Values below reach the Mailpit of docker compose (http://localhost:8025).
# Inside docker compose use MAIL_HOST=mailpit, or your real SMTP server.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=COMPTA
MAIL_FROM_EMAIL=no-reply@compta.invalid

# Drops the database of DELETED tenants after 30 days, only when they have an export (F01 BR-06). Keep false unless decided.
TENANT_PURGE_ENABLED=false

# Host ports published by docker compose. Change them to run a second stack next to the first.
# Production must not publish RabbitMQ (either port), the MinIO console or Mailpit: see "Cổng mở trên host" in the README.
# Address those infrastructure ports listen on. Default 0.0.0.0 reaches the whole network with development passwords:
# use 127.0.0.1 unless another machine needs them. The API and the MinIO API stay reachable, browsers need them.
# INFRA_BIND_ADDRESS=127.0.0.1
# POSTGRES_PORT=5432
# APP_PORT=3000
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Shared with the frontend proxy, which proves with it the X-Client-Ip it sends. Required in production.
# INTERNAL_PROXY_SECRET=change-me
# /metrics answers 404 without this bearer token
# METRICS_TOKEN=change-me
# Optional error reporting
# SENTRY_DSN=

# Chat assistant (POST /assistant/chat); unset = local keyword answers
# OPENAI_API_KEY=
# ASSISTANT_MODEL=gpt-4o-mini
